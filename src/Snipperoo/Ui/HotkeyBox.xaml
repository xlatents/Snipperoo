<UserControl x:Class="Snipperoo.Ui.HotkeyBox" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
    <StackPanel HorizontalAlignment="Right">
        <Border x:Name="Box" CornerRadius="10" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1.5" Padding="8,0" MinWidth="168" Height="42">
            <Grid>
                <ItemsControl x:Name="KeyList" VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Keycap}" Margin="2,0">
                                <TextBlock Style="{StaticResource KeycapText}" Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Prompt" Text="Press your keys…" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentSolidBrush}" FontWeight="SemiBold" />
            </Grid>
        </Border>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,6,2,0"
                   Style="{StaticResource CaptionText}" Foreground="{StaticResource DangerBrush}" FontSize="12" />
    </StackPanel>
</UserControl>
