<UserControl x:Class="Snipperoo.Ui.PlanPicker" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Check mark shown in the corner of the selected card. -->
        <Style x:Key="SelectedMark" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility"
                    Value="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <Style x:Key="SizeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Columns="3">
        <RadioButton x:Name="FreeCard" Style="{StaticResource CardRadio}" Margin="0,0,6,0" Checked="OnChecked">
            <Grid>
                <StackPanel>
                    <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE77B;" />
                    </Border>
                    <TextBlock Style="{StaticResource StrongText}" Text="Free" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource SizeText}" Text="10 MB" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="per upload" />
                </StackPanel>
                <Border Style="{StaticResource SelectedMark}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="10" Foreground="White" />
                </Border>
            </Grid>
        </RadioButton>
        <RadioButton x:Name="BasicCard" Style="{StaticResource CardRadio}" Margin="3,0,3,0" Checked="OnChecked">
            <Grid>
                <StackPanel>
                    <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE734;" />
                    </Border>
                    <TextBlock Style="{StaticResource StrongText}" Text="Nitro Basic" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource SizeText}" Text="50 MB" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="per upload" />
                </StackPanel>
                <Border Style="{StaticResource SelectedMark}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="10" Foreground="White" />
                </Border>
            </Grid>
        </RadioButton>
        <RadioButton x:Name="NitroCard" Style="{StaticResource CardRadio}" Margin="6,0,0,0" Checked="OnChecked">
            <Grid>
                <StackPanel>
                    <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" Foreground="White" />
                    </Border>
                    <TextBlock Style="{StaticResource StrongText}" Text="Nitro" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource SizeText}" Text="500 MB" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="per upload" />
                </StackPanel>
                <Border Style="{StaticResource SelectedMark}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="10" Foreground="White" />
                </Border>
            </Grid>
        </RadioButton>
    </UniformGrid>
</UserControl>
