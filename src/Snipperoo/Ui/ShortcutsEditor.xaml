<UserControl x:Class="Snipperoo.Ui.ShortcutsEditor" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Snipperoo.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE714;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource StrongText}" Text="Record a clip" Margin="0,2,0,2" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Pick an area to record. Press again to stop." />
                </StackPanel>
                <ui:HotkeyBox x:Name="RecordBox" Grid.Column="2" VerticalAlignment="Top" />
            </Grid>
            <Border Height="1" Background="{StaticResource StrokeBrush}" />
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE722;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource StrongText}" Text="Take a screenshot" Margin="0,2,0,2" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Pick an area and it's on your clipboard." />
                </StackPanel>
                <ui:HotkeyBox x:Name="ScreenshotBox" Grid.Column="2" VerticalAlignment="Top" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
